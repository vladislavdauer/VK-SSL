@@ -0,0 +1,46 @@
+"""Offline codec targets in the same `utt_id z1 z2 ...` format as dump_labels.py (one file per codebook).
+
+Cost: one forward pass of a small frozen codec over the corpus (~hours on one GPU for 960 h) vs
+feature dump + k-means fit + label dump (+ a 2nd iteration with a pretrained HuBERT).
+Use --train-hubert ... --label-paths codec_q0.km codec_q1.km ... --num-classes 1024,1024,...
+"""
+import pathlib
+from argparse import ArgumentParser
+
+import torch
+import torchaudio
+
+from src.codec import build_codec
+from src.data.hubert_transforms import librispeech_utt_id, waveform_16k
+
+
+def run_dump(args):
+    device = "cuda" if torch.cuda.is_available() else "cpu"
+    extractor = build_codec(args.codec, args.num_q).to(device)
+    args.out_dir.mkdir(parents=True, exist_ok=True)
+    handles = [open(args.out_dir / f"codec_q{q}.km", "w", encoding="utf-8") for q in range(args.num_q)]
+    for subset in args.subsets:
+        ds = torchaudio.datasets.LIBRISPEECH(str(args.librispeech_path), url=subset, download=False)
+        for sample in ds:
+            wav = waveform_16k(sample).to(device)[None]
+            codes = extractor(wav, torch.tensor([wav.numel()], device=device))
+            utt = librispeech_utt_id(sample)
+            for q, c in enumerate(codes):
+                handles[q].write(utt + " " + " ".join(map(str, c[0].tolist())) + "\n")
+
+    for h in handles:
+        h.close()
+
+
+def cli_main():
+    p = ArgumentParser()
+    p.add_argument("--librispeech-path", type=pathlib.Path, required=True)
+    p.add_argument("--subsets", nargs="+", default=["train-clean-100", "train-clean-360", "train-other-500", "dev-clean", "dev-other"])
+    p.add_argument("--codec", default="dac-16khz")
+    p.add_argument("--num-q", type=int, default=4)
+    p.add_argument("--out-dir", type=pathlib.Path, required=True)
+    run_dump(p.parse_args())
+
+
+if __name__ == "__main__":
+    cli_main()
