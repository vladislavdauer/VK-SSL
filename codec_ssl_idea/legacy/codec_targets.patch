@@ -0,0 +1,77 @@
+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from src.codec import build_codec
+from src.models.hubert.config import get_hubert_config
+from src.models.hubert.hubert_model import HubertModel
+from src.models.hubert.masking import compute_span_mask
+from src.models.hubert.prediction_head import HubertPredictionHead
+
+
+class TestEfficientHead(unittest.TestCase):
+    def test_matmul_logits_equal_cosine_similarity(self):
+        head = HubertPredictionHead(32, 16, [64], logit_temp=0.1)
+        h = torch.randn(3, 7, 32)
+        proj = head.projections[0](h)
+        ref = F.cosine_similarity(proj.unsqueeze(-2), head.label_embs[0].unsqueeze(0), dim=-1) / 0.1
+        self.assertTrue(torch.allclose(head.logits(h), ref, atol=1e-4))
+
+
+class TestVectorisedMask(unittest.TestCase):
+    def test_invariants(self):
+        torch.manual_seed(0)
+        lengths = torch.tensor([200, 150, 60, 1, 12])
+        for _ in range(50):
+            m = compute_span_mask(lengths, 0.08, 10, 2)
+            for i, n in enumerate(lengths.tolist()):
+                self.assertFalse(m[i, n:].any())
+                if n > 1:
+                    self.assertTrue(m[i, :n].any())
+                    self.assertFalse(m[i, :n].all())
+
+    def test_ratio_close_to_hubert(self):
+        torch.manual_seed(0)
+        m = compute_span_mask(torch.full((256,), 400), 0.08, 10, 2).float().mean().item()
+        self.assertTrue(0.50 < m < 0.60, m)  # 1-(1-0.08)^10 ~= 0.57; matches the previous loop implementation
+
+
+class TestCodecPretrain(unittest.TestCase):
+    def test_multi_head_weighted_loss_and_curriculum(self):
+        torch.manual_seed(0)
+        ext = build_codec("stub", 3)
+        cfg = get_hubert_config("tiny", num_classes=[ext.codebook_size] * 3, label_rate=50.0)
+        cfg.codebook_weights = [1.0, 0.5, 0.25]
+        model = HubertModel(cfg)
+        src = torch.randn(2, 16000)
+        lengths = torch.tensor([16000, 12000])
+        out = model(src, lengths, ext(src, lengths))
+        self.assertEqual(len(out["logit_m_list"]), 3)
+        loss = model.masked_prediction_loss(out)
+        loss.backward()
+        self.assertTrue(torch.isfinite(loss))
+        model.active_heads = 1
+        out = model(src, lengths, ext(src, lengths))
+        self.assertEqual(len(out["logit_m_list"]), 1)
+        self.assertTrue(torch.isfinite(model.masked_prediction_loss(out)))
+
+    def test_overfits_codec_targets(self):
+        torch.manual_seed(0)
+        ext = build_codec("stub", 1)
+        cfg = get_hubert_config("tiny", num_classes=[ext.codebook_size], label_rate=50.0)
+        model = HubertModel(cfg)
+        opt = torch.optim.Adam(model.parameters(), 1e-3)
+        src = torch.randn(4, 8000)
+        lengths = torch.full((4,), 8000)
+        tg = ext(src, lengths)
+        first = None
+        for _ in range(60):
+            loss = model.masked_prediction_loss(model(src, lengths, tg))
+            opt.zero_grad(); loss.backward(); opt.step()
+            first = first if first is not None else loss.item()
+        self.assertLess(loss.item(), first)
+
+
+if __name__ == "__main__":
+    unittest.main()
