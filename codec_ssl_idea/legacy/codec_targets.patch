@@ -0,0 +1,102 @@
+"""Frozen neural-codec RVQ indices as HuBERT masked-prediction targets.
+
+Replaces the k-means stage (MFCC k-means -> layer-6 k-means -> ...) with the codebook
+indices of a pretrained RVQ codec: no feature dump to disk, no clustering iterations.
+
+HuBERT's CNN has a 320x stride at 16 kHz = 50 Hz. DAC-16kHz (hop 320, 12 x 1024 RVQ)
+matches it exactly, so no target resampling is needed. Codecs with another frame rate
+(EnCodec-24k: 75 Hz, Mimi: 12.5 Hz) are resampled in time by nearest-neighbour
+interpolation of the *indices* (never of embeddings).
+"""
+from typing import List, Optional
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+class CodecTargetExtractor(nn.Module):
+    """codec: object with .encode_codes(wav[B,1,T]) -> LongTensor[B,Q,Tc]; sample_rate, frame_rate, codebook_size."""
+
+    def __init__(self, codec, num_q: int, target_rate: float = 50.0):
+        super().__init__()
+        self.codec = codec
+        self.num_q = num_q
+        self.target_rate = target_rate
+        for p in self.codec.parameters():
+            p.requires_grad = False
+
+        self.codec.eval()
+
+    @property
+    def codebook_size(self) -> int:
+        return self.codec.codebook_size
+
+    def train(self, mode: bool = True):  # codec always stays in eval mode
+        return super().train(False)
+
+    @torch.no_grad()
+    def forward(self, wav: torch.Tensor, lengths: torch.Tensor) -> List[torch.Tensor]:
+        """wav: [B, T] at 16 kHz (HuBERT input). Returns Q tensors [B, T_label] (long)."""
+        x = wav.unsqueeze(1)
+        if self.codec.sample_rate != 16000:
+            import torchaudio
+
+            x = torchaudio.functional.resample(x, 16000, self.codec.sample_rate)
+
+        codes = self.codec.encode_codes(x)[:, : self.num_q]  # [B, Q, Tc]
+        if abs(self.codec.frame_rate - self.target_rate) > 1e-6:
+            n_out = int(round(codes.size(-1) * self.target_rate / self.codec.frame_rate))
+            idx = (torch.arange(n_out, device=codes.device) * self.codec.frame_rate / self.target_rate).long()
+            codes = codes.index_select(-1, idx.clamp(max=codes.size(-1) - 1))
+
+        return [codes[:, q].contiguous() for q in range(codes.size(1))]
+
+
+class DACCodec(nn.Module):
+    """descript-audio-codec wrapper (pip install descript-audio-codec). 16 kHz model: 50 Hz, 12 x 1024."""
+
+    def __init__(self, model_type: str = "16khz"):
+        super().__init__()
+        import dac
+
+        self.model = dac.DAC.load(dac.utils.download(model_type=model_type))
+        self.sample_rate = int(self.model.sample_rate)
+        self.frame_rate = self.sample_rate / int(self.model.hop_length)
+        self.codebook_size = int(self.model.codebook_size)
+
+    @torch.no_grad()
+    def encode_codes(self, wav: torch.Tensor) -> torch.Tensor:
+        wav = self.model.preprocess(wav, self.sample_rate)
+        _, codes, *_ = self.model.encode(wav)
+        return codes.long()
+
+
+class StubCodec(nn.Module):
+    """Dependency-free stand-in for tests / CPU smoke runs: strided-frame hash -> RVQ-like indices."""
+
+    def __init__(self, num_q: int = 4, codebook_size: int = 1024, hop: int = 320):
+        super().__init__()
+        self.sample_rate, self.hop, self.codebook_size = 16000, hop, codebook_size
+        self.frame_rate = 16000 / hop
+        self.num_q = num_q
+        self.register_buffer("proj", torch.randn(num_q, hop))
+
+    @torch.no_grad()
+    def encode_codes(self, wav: torch.Tensor) -> torch.Tensor:
+        x = wav.squeeze(1)
+        n = x.size(-1) // self.hop
+        frames = x[:, : n * self.hop].reshape(x.size(0), n, self.hop)
+        score = torch.einsum("bth,qh->bqt", frames, self.proj)
+        return ((score * 1e3).long() % self.codebook_size).abs()
+
+
+def build_codec(name: str, num_q: int, target_rate: float = 50.0) -> CodecTargetExtractor:
+    if name == "stub":
+        codec = StubCodec(num_q=num_q)
+    elif name.startswith("dac"):
+        codec = DACCodec(name.split("-", 1)[1] if "-" in name else "16khz")
+    else:
+        raise ValueError(f"unknown codec '{name}' (supported: dac-16khz, dac-24khz, stub; add Mimi/EnCodec wrappers here)")
+
+    return CodecTargetExtractor(codec, num_q=num_q, target_rate=target_rate)
